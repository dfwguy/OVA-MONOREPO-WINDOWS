<service>
  <id>OVA-NativeObservability-REPLACE_WITH_UNIQUE_ID</id>
  <name>OVA Native Observability</name>
  <description>Native Windows Grafana, Prometheus, Loki and Alloy supervisor. Site commissioning required.</description>
  <executable>__ABSOLUTE_64BIT_PYTHON_EXE__</executable>
  <arguments>&quot;__ABSOLUTE_NATIVE_CORE_PY__&quot; serve --runtime-root &quot;__ABSOLUTE_PRIVATE_RUNTIME_ROOT__&quot;</arguments>
  <workingdirectory>__ABSOLUTE_PRIVATE_RUNTIME_ROOT__</workingdirectory>
  <logpath>__ABSOLUTE_PRIVATE_RUNTIME_ROOT__\logs\supervisor</logpath>
  <log mode="roll" />
  <stoptimeout>60sec</stoptimeout>
</service>
