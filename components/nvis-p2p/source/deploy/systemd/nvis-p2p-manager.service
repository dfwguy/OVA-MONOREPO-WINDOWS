[Unit]
Description=NVIS-P2P Dragonfly manager
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=nvis-p2p
Group=nvis-p2p
WorkingDirectory=/srv/nvis/NVIS-P2P
ExecStart=/srv/nvis/NVIS-P2P/dist/core/manager --config /srv/nvis/NVIS-P2P/configs/manager.yaml --console
Restart=always
RestartSec=5s
LimitNOFILE=1048576
TasksMax=8192
StandardOutput=append:/srv/nvis/NVIS-P2P/state/manager-service.log
StandardError=append:/srv/nvis/NVIS-P2P/state/manager-service.log

[Install]
WantedBy=multi-user.target
