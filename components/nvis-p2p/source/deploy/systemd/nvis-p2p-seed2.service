[Unit]
Description=NVIS-P2P Dragonfly seed peer 2
After=network-online.target docker.service nvis-p2p-manager.service
Wants=network-online.target

[Service]
Type=simple
User=nvis-p2p
Group=nvis-p2p
WorkingDirectory=/srv/nvis/NVIS-P2P
ExecStart=/srv/nvis/NVIS-P2P/dist/client-amd64-v1.4.9/dfdaemon --config /srv/nvis/NVIS-P2P/configs/seed2.yaml --log-dir /srv/nvis/NVIS-P2P/state/seed2/logs --console
Restart=always
RestartSec=5s
LimitNOFILE=1048576
TasksMax=8192
StandardOutput=append:/srv/nvis/NVIS-P2P/state/seed2/dfdaemon-service.log
StandardError=append:/srv/nvis/NVIS-P2P/state/seed2/dfdaemon-service.log

[Install]
WantedBy=multi-user.target
