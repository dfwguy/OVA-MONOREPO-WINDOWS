{
  "server": {
    "advertiseIP": "192.0.2.10",
    "advertisePort": 12002,
    "listenIP": "192.0.2.10",
    "port": 12002,
    "logDir": "/srv/nvis/NVIS-P2P/state/scheduler/logs",
    "pluginDir": "/srv/nvis/NVIS-P2P/state/scheduler/plugins",
    "dataDir": "/srv/nvis/NVIS-P2P/state/scheduler/data"
  },
  "scheduler": {
    "algorithm": "default",
    "backToSourceCount": 1,
    "retryBackToSourceLimit": 3,
    "retryLimit": 5,
    "retryInterval": "1s",
    "gc": {
      "pieceDownloadTimeout": "45m",
      "peerGCInterval": "10s",
      "peerTTL": "24h",
      "taskGCInterval": "30m",
      "hostGCInterval": "5m",
      "hostTTL": "1h"
    }
  },
  "database": {
    "redis": {
      "addrs": [
        "127.0.0.1:15379"
      ],
      "brokerDB": 3,
      "backendDB": 4,
      "poolSize": 1024,
      "poolTimeout": "10s"
    }
  },
  "dynConfig": {
    "refreshInterval": "1m"
  },
  "manager": {
    "addr": "192.0.2.10:12003",
    "schedulerClusterID": 1,
    "keepAlive": {
      "interval": "5s"
    }
  },
  "host": {
    "idc": "iren-mkz",
    "location": "appserver"
  },
  "seedPeer": {},
  "job": {
    "enable": false
  },
  "storage": {
    "maxSize": 100,
    "maxBackups": 10,
    "bufferSize": 100
  },
  "metrics": {
    "enable": true,
    "addr": "192.0.2.10:12001",
    "enableHost": true
  },
  "network": {
    "enableIPv6": false
  },
  "console": true,
  "pprofPort": -1,
  "applications": []
}
