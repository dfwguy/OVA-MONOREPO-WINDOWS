+// credentialUser uses the Row/Scan callback path so JSON query caches cannot
+// discard json:"-" credential fields. Public User serialization stays unchanged.
+func (s *service) credentialUser(ctx context.Context, condition *models.User) (*models.User, error) {
+	if condition == nil || (condition.ID == 0 && condition.Name == "") {
+		return nil, gorm.ErrRecordNotFound
+	}
+	user := models.User{}
+	if err := s.db.WithContext(ctx).Model(&models.User{}).Where(condition).Limit(1).Scan(&user).Error; err != nil {
+		return nil, err
+	}
+	if user.ID == 0 || user.IsDel != 0 || user.State != models.UserStateEnabled {
+		return nil, gorm.ErrRecordNotFound
+	}
+	return &user, nil
+}
