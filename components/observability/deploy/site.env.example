# Copy outside source; chmod 600. This file is read on REMOTE LINUX, not PowerShell.
OBS_DATA_ROOT=/var/lib/iren-mkz-observability
GF_SECURITY_ADMIN_PASSWORD=
GRAFANA_ADMIN_USER=nvis
PLUGIN_DIR=/opt/iren-mkz/dependencies/observability/plugins-linux-amd64
WHEELHOUSE_DIR=/opt/iren-mkz/dependencies/observability/wheels-linux-amd64
# Default denies remote ingest. Set to approved Linux management interface only
# after firewall rules restrict 9098/9099 to approved IREN node subnets.
OBS_INGEST_BIND=127.0.0.1
