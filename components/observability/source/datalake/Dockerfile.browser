FROM python:3.12-slim

RUN pip install --no-cache-dir duckdb==1.1.1 \
    && useradd --system --uid 65532 --home-dir /nonexistent --shell /usr/sbin/nologin browser

WORKDIR /app
COPY lake_browser.py /app/lake_browser.py
RUN chmod 0444 /app/lake_browser.py

USER 65532:65532
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ENTRYPOINT ["python", "/app/lake_browser.py"]
