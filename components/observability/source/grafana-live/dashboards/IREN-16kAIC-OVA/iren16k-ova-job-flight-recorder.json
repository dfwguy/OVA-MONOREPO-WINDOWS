    {
      "datasource": {
        "type": "prometheus",
        "uid": "nvis-victoriametrics"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "yellow",
                  "text": "UNKNOWN"
                },
                "1": {
                  "color": "yellow",
                  "text": "PENDING"
                },
                "10": {
                  "color": "red",
                  "text": "OUT OF MEMORY"
                },
                "11": {
                  "color": "orange",
                  "text": "PREEMPTED"
                },
                "12": {
                  "color": "orange",
                  "text": "SUSPENDED"
                },
                "2": {
                  "color": "blue",
                  "text": "CONFIGURING"
                },
                "3": {
                  "color": "green",
                  "text": "RUNNING"
                },
                "4": {
                  "color": "blue",
                  "text": "COMPLETING"
                },
                "5": {
                  "color": "green",
                  "text": "COMPLETED"
                },
                "6": {
                  "color": "orange",
                  "text": "CANCELLED"
                },
                "7": {
                  "color": "red",
                  "text": "FAILED"
                },
                "8": {
                  "color": "red",
                  "text": "TIMEOUT"
                },
                "9": {
                  "color": "red",
                  "text": "NODE FAIL"
                }
              },
              "type": "value"
            }
          ],
          "noValue": "NO DATA",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "green",
                "value": 1
