        "showPercentChange": false,
        "text": {
          "valueSize": 44
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nvis-victoriametrics"
          },
          "editorMode": "code",
          "expr": "count(count by(instance,hca)(ib_hca_symbol_error{cluster=~\"$cluster\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\",hca=~\"$hca\"} > 0 or ib_hca_link_error_recovery{cluster=~\"$cluster\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\",hca=~\"$hca\"} > 0 or ib_hca_port_rcv_errors{cluster=~\"$cluster\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\",hca=~\"$hca\"} > 0)) or vector(0)",
