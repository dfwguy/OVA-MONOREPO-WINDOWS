    {
      "datasource": {
        "type": "prometheus",
        "uid": "nvis-victoriametrics"
      },
      "description": "Distinct rails reporting a symbol error, a link-error recovery or a receive error \u2014 the three host-side counters that describe wire quality. Per-counter totals are itemised on the Port Errors and Link Flaps boards; this board owns the physical-layer picture. The table beside this number is built from the identical selector, so its row count equals the number shown.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-green",
                "value": null
              },
              {
                "color": "#B77D34",
                "value": 1
              },
              {
                "color": "dark-red",
                "value": 25
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
