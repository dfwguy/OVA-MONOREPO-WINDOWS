        "y": 0
      },
      "options": {
        "content": "<div style='padding:14px 18px;border-left:4px solid #3D71D9;background:#181B1F;border-radius:3px'><div style='font-size:20px;font-weight:600;color:#D8D9DA;letter-spacing:.3px'>GPUs \u2014 $node</div><div style='font-size:13px;color:#8E9297;margin-top:4px'>$rack \u00b7 $su \u00b7 per-GPU utilisation, temperature, power, clocks, ECC and NVLink</div></div>",
