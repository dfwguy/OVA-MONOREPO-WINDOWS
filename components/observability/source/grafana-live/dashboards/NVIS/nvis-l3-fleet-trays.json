{
  "description": "Trays within one rack. Green requires node_exporter, DCGM and cgroup all up. Click a tray for its GPUs.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "content": "<div style='padding:14px 18px;border-left:4px solid #3D71D9;background:#181B1F;border-radius:3px'><div style='font-size:20px;font-weight:600;color:#D8D9DA;letter-spacing:.3px'>Trays \u2014 $rack</div><div style='font-size:13px;color:#8E9297;margin-top:4px'>Green = node_exporter + DCGM + cgroup all healthy \u00b7 click a tray to open its GPUs</div></div>",
        "mode": "html"
      },
      "title": "",
      "type": "text"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-red",
                "value": null
              },
              {
                "color": "#B77D34",
                "value": 15
              },
              {
                "color": "dark-green",
                "value": 18
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 3
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "count(max_over_time(up{job=~\"node|node-exporter\", instance=~\"example50.*\", rack=\"$rack\"}[15m]) == 1)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Trays up",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-red",
                "value": null
              },
              {
                "color": "#B77D34",
                "value": 40
              },
              {
                "color": "dark-green",
                "value": 72
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 3
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "count(DCGM_FI_DEV_GPU_UTIL{instance=~\"example50.*\", rack=\"$rack\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "GPUs present",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-green",
                "value": null
              },
              {
                "color": "#B77D34",
                "value": 80
              },
              {
                "color": "dark-red",
                "value": 88
              }
            ]
          },
          "unit": "celsius"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 3
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "max(DCGM_FI_DEV_GPU_TEMP{instance=~\"example50.*\", rack=\"$rack\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Max GPU temp",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-green",
                "value": null
              }
            ]
          },
          "unit": "watt"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 3
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(DCGM_FI_DEV_POWER_USAGE{instance=~\"example50.*\", rack=\"$rack\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Rack power",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-green",
                "value": null
              },
              {
                "color": "dark-red",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 3
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "count(DCGM_FI_DEV_ECC_DBE_VOL_TOTAL{instance=~\"example50.*\", rack=\"$rack\"} > 0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "GPUs w/ uncorrectable ECC",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-green",
                "value": null
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 3
      },
      "links": [
        {
          "targetBlank": false,
          "title": "Back to racks",
          "url": "/d/nvis-l2-fleet-racks/?var-su=$su"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "\u2190 Back to $su",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "panels": [],
      "title": "Trays in $rack  \u00b7  all exporters healthy  \u00b7  click to open GPUs",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Green only when node_exporter, DCGM and cgroup are ALL up on this tray.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-red",
                "value": null
              },
              {
                "color": "dark-green",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 2,
        "x": 0,
        "y": 8
      },
      "links": [
        {
          "targetBlank": false,
          "title": "Open GPUs on $node",
          "url": "/d/nvis-l4-tray-gpus/?var-su=$su&var-rack=$rack&var-node=$node"
        }
      ],
      "maxPerRow": 9,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      },
      "repeat": "node",
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "min(up{instance=~\"example50.*\", node=\"$node\", job=~\"node|node-exporter|dcgm|dcgm-exporter|cgroup|cgroup-exporter\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "$node",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "panels": [],
      "title": "Tray detail \u2014 $rack",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "node_exp|DCGM|cgroup"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "0": {
                        "color": "dark-red",
                        "index": 0,
                        "text": "DOWN"
                      },
                      "1": {
                        "color": "dark-green",
                        "index": 1,
                        "text": "UP"
                      }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "dark-red",
                      "value": null
                    },
                    {
                      "color": "dark-green",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Uptime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Max GPU \u00b0C"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "dark-green",
                      "value": null
                    },
                    {
                      "color": "#B77D34",
                      "value": 80
                    },
                    {
                      "color": "dark-red",
                      "value": 88
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "GPU util %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Power W"
            },
            "properties": [
              {
                "id": "unit",
                "value": "watt"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "expr": "up{job=~\"node|node-exporter\", instance=~\"example50.*\", rack=\"$rack\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "up{job=~\"dcgm|dcgm-exporter\", instance=~\"example50.*\", rack=\"$rack\"}",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "up{job=~\"cgroup|cgroup-exporter\", instance=~\"example50.*\", rack=\"$rack\"}",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "expr": "(node_time_seconds{instance=~\"example50.*\", rack=\"$rack\"} - node_boot_time_seconds{instance=~\"example50.*\", rack=\"$rack\"})",
          "format": "table",
          "instant": true,
          "refId": "D"
        },
        {
          "expr": "node_load1{instance=~\"example50.*\", rack=\"$rack\"}",
          "format": "table",
          "instant": true,
          "refId": "E"
        },
        {
          "expr": "max by (node)(DCGM_FI_DEV_GPU_TEMP{instance=~\"example50.*\", rack=\"$rack\"})",
          "format": "table",
          "instant": true,
          "refId": "F"
        },
        {
          "expr": "avg by (node)(DCGM_FI_DEV_GPU_UTIL{instance=~\"example50.*\", rack=\"$rack\"})",
          "format": "table",
          "instant": true,
          "refId": "G"
        },
        {
          "expr": "sum by (node)(DCGM_FI_DEV_POWER_USAGE{instance=~\"example50.*\", rack=\"$rack\"})",
          "format": "table",
          "instant": true,
          "refId": "H"
        }
      ],
      "title": "Per-tray health, uptime, load and temperature",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "node",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true,
              "Time 7": true,
              "Time 8": true,
              "__name__": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "__name__ 3": true,
              "__name__ 4": true,
              "__name__ 5": true,
              "cluster": true,
              "datahall": true,
              "dgx_flavor": true,
              "instance": true,
              "instance 1": true,
              "instance 2": true,
              "instance 3": true,
              "instance 4": true,
              "instance 5": true,
              "instance 6": true,
              "instance 7": true,
              "instance 8": true,
              "job": true,
              "job 1": true,
              "job 2": true,
              "job 3": true,
              "job 4": true,
              "job 5": true,
              "job 6": true,
              "job 7": true,
              "job 8": true,
              "nvis_direct": true,
              "rack": true,
              "rack_ordinal": true,
              "racktype": true,
              "service": true,
              "su": true,
              "su_letter": true
            },
            "renameByName": {
              "Value #A": "node_exp",
              "Value #B": "DCGM",
              "Value #C": "cgroup",
              "Value #D": "Uptime",
              "Value #E": "Load1",
              "Value #F": "Max GPU \u00b0C",
              "Value #G": "GPU util %",
              "Value #H": "Power W",
              "node": "Tray"
            }
          }
        }
      ],
      "type": "table"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "nvis",
    "fleet",
    "drilldown"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "text": "nvis-victoriametrics",
          "value": "nvis-victoriametrics"
        },
        "hide": 2,
        "name": "datasource",
        "query": "prometheus",
        "type": "datasource"
      },
      {
        "current": {
          "text": "",
          "value": "",
          "selected": false
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "hide": 0,
        "includeAll": false,
        "label": "SU",
        "multi": false,
        "name": "su",
        "query": {
          "query": "label_values(up{job=~\"node|node-exporter\", instance=~\"example50.*\"}, su)",
          "refId": "su"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query",
        "options": []
      },
      {
        "current": {
          "text": "",
          "value": "",
          "selected": false
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "hide": 0,
        "includeAll": false,
        "label": "Rack",
        "multi": false,
        "name": "rack",
        "query": {
          "query": "label_values(up{job=~\"node|node-exporter\", instance=~\"example50.*\", su=\"$su\"}, rack)",
          "refId": "rack"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query",
        "options": []
      },
      {
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all",
          "selected": true
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "hide": 2,
        "includeAll": true,
        "label": "Tray",
        "multi": true,
        "name": "node",
        "query": {
          "query": "label_values(up{job=~\"node|node-exporter\", instance=~\"example50.*\", rack=\"$rack\"}, node)",
          "refId": "node"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query",
        "options": []
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "utc",
  "title": "Trays \u2014 $rack (L3)",
  "uid": "nvis-l3-fleet-trays",
  "version": 1
}
