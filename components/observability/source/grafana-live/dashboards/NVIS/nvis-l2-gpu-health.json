          "editorMode": "code",
          "expr": "count by(rack, su) (DCGM_FI_DEV_XID_ERRORS{cluster=~\"$cluster\", datahall=~\"$datahall\", su=~\"$su\", rack=~\"$rack\", node=~\"$node\"})",
