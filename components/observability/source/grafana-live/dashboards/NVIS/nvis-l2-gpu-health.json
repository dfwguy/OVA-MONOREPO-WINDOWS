          "editorMode": "code",
          "expr": "count by(rack, su) (max by(node, gpu, rack, su) (DCGM_FI_DEV_ECC_DBE_VOL_TOTAL{cluster=~\"$cluster\", datahall=~\"$datahall\", su=~\"$su\", rack=~\"$rack\", node=~\"$node\"}) > 0 or max by(node, gpu, rack, su) (DCGM_FI_DEV_ECC_SBE_VOL_TOTAL{cluster=~\"$cluster\", datahall=~\"$datahall\", su=~\"$su\", rack=~\"$rack\", node=~\"$node\"}) > 0 or max by(node, gpu, rack, su) (DCGM_FI_DEV_ECC_DBE_AGG_TOTAL{cluster=~\"$cluster\", datahall=~\"$datahall\", su=~\"$su\", rack=~\"$rack\", node=~\"$node\"}) > 0 or max by(node, gpu, rack, su) (DCGM_FI_DEV_ECC_SBE_AGG_TOTAL{cluster=~\"$cluster\", datahall=~\"$datahall\", su=~\"$su\", rack=~\"$rack\", node=~\"$node\"}) > 0 or max by(node, gpu, rack, su) (DCGM_FI_DEV_CORRECTABLE_REMAPPED_ROWS{cluster=~\"$cluster\", datahall=~\"$datahall\", su=~\"$su\", rack=~\"$rack\", node=~\"$node\"}) > 0 or max by(node, gpu, rack, su) (DCGM_FI_DEV_UNCORRECTABLE_REMAPPED_ROWS{cluster=~\"$cluster\", datahall=~\"$datahall\", su=~\"$su\", rack=~\"$rack\", node=~\"$node\"}) > 0)",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "count by(rack, su) (count by(node, gpu, rack, su) (su1_nvlink_up{cluster=~\"$cluster\", datahall=~\"$datahall\", su=~\"$su\", rack=~\"$rack\", node=~\"$node\"}) < 18)",
          "format": "table",
