  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "nvis-prometheus"
      },
      "description": "This dashboard reads DCGM directly from Prometheus. XID is coverage-aware: NOT EXPORTED is different from zero events.",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "### DCGM GPU reliability\n**XID** driver faults \u00b7 **ECC** persistent and volatile errors \u00b7 **HBM** capacity and temperature \u00b7 **Clocks** SM/memory frequency and throttle reasons\n\nUse the rack, node, and GPU filters above. Fleet charts show the worst 20 GPUs to keep the dashboard responsive. **XID coverage must show a series count before XID event panels can be trusted.**",
        "mode": "markdown"
      },
      "pluginVersion": "11.1.4",
      "title": "How to read this dashboard",
      "type": "text"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "nvis-prometheus"
      },
      "description": "Number of healthy DCGM exporter targets in the selected scope.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 3
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
