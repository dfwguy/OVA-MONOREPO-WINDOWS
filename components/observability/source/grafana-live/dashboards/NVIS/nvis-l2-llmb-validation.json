        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nvis-victoriametrics"
          },
          "expr": "count(up{job=\"cgroup-exporter\"} == 1) or on() vector(0)",
