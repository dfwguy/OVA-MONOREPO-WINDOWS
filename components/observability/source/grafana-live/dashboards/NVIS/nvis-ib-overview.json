    {
      "datasource": {
        "type": "prometheus",
        "uid": "nvis-victoriametrics"
      },
      "description": "IB-plane scrape targets returning up == 0, out of every target the ObsVM probes with plane=\"ib\" (the ib-identity, ib-switch-audit, ib-switch-live, ib-lldp and ib-cable-issue sweeps plus the two UFM collectors). Every target counted here is named in the table beside it, from the same selector.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-green",
                "value": null
              },
              {
                "color": "dark-red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 6,
        "x": 0,
        "y": 5
      },
      "id": 9102,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "valueSize": 64
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nvis-victoriametrics"
          },
          "editorMode": "code",
          "expr": "count(up{plane=\"ib\",cluster=~\"$cluster\"} == 0) or vector(0)",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "IB collector endpoints not answering",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "nvis-victoriametrics"
      },
      "description": "Same selector as the stat above: up{plane=\"ib\"} == 0. Row count equals that stat.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "0": {
                        "color": "dark-red",
                        "index": 0,
                        "text": "NOT ANSWERING"
                      },
                      "1": {
                        "color": "dark-green",
                        "index": 1,
                        "text": "Reporting"
                      }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 160
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 10,
        "w": 18,
        "x": 6,
        "y": 5
      },
      "id": 9104,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": false,
            "displayName": "Collector"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nvis-victoriametrics"
          },
          "editorMode": "code",
          "expr": "up{plane=\"ib\",cluster=~\"$cluster\"} == 0",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "IB collector endpoints not answering \u2014 the exact targets",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "cluster": true,
              "plane": true
            },
            "indexByName": {
              "Value": 2,
              "instance": 1,
              "job": 0
            },
            "renameByName": {
              "Value": "State",
              "instance": "Scrape target",
              "job": "Collector"
            }
          }
        }
      ],
      "type": "table"
    },
