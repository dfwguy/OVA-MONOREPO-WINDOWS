        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nvis-victoriametrics"
          },
          "expr": "count(count by(node)(ib_hca_port_state{cluster=~\"$cluster\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\",hca=~\"$hca\"} != 4)) or vector(0)",
