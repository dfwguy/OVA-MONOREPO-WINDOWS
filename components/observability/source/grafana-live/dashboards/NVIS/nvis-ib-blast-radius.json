    {
      "datasource": {
        "type": "prometheus",
        "uid": "nvis-victoriametrics"
      },
      "description": "Trays presenting at least one HCA rail that is not ACTIVE. This board is the canonical home of tray- and rack-level IB blast radius. Source: <code>ib_hca_port_state</code>, read on every DGX tray by node-exporter. The table beside this number is built from the identical selector, so its row count equals the number shown.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-green",
                "value": null
              },
              {
                "color": "#B77D34",
