{
  "description": "Live 16K node readiness view. The authoritative expected topology is /tmp/val.txt: 3,978 nodes across 14 Super Units (SU4 has 13 active racks; d20, d23, and d24 are excluded). Green means node-exporter reachable; gray means no target has published a value.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "icon": "external link",
      "includeTimeRange": true,
      "keepTime": true,
      "targetBlank": false,
      "title": "Open Live Topology",
      "type": "link",
      "url": "/d/nvis-live-topology-v2/"
    },
    {
      "icon": "external link",
      "includeTimeRange": true,
      "keepTime": true,
      "targetBlank": false,
      "title": "Open Node Deep Dive",
      "type": "link",
      "url": "/d/nvis-node-deep-dive/"
    }
  ],
  "panels": [
    {
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "content": "<div style='padding:14px 18px;border-left:4px solid #76B900;background:#181B1F;border-radius:3px'><div style='font-size:20px;font-weight:600;color:#D8D9DA;letter-spacing:.3px'>Kishore Node View</div><div style='font-size:13px;color:#A7ABB0;margin-top:5px'>Authoritative topology: 3,978 nodes from val.txt \u00b7 SU1\u2013SU14 \u00b7 16 racks per SU except SU4 (13) \u00b7 18 nodes per rack. Green = node exporter reachable; gray = no data. Refreshes every 30 seconds.</div></div>",
        "mode": "html"
      },
      "title": "",
      "type": "text"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-red",
                "value": null
              },
              {
                "color": "dark-green",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 3
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "count(max by(node)(up{job=\"node-exporter\",node!=\"\",su=~\"$su\",node!~\"example50-dh02-d(20|23|24)-.*\"}) == 1)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Node exporter reachable",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "No Slurm node-state metric is currently exported to VictoriaMetrics; this is intentionally shown as unavailable rather than treated as a node failure.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "dark-gray",
            "mode": "fixed"
          },
          "decimals": 0,
          "noValue": "NOT EXPORTED",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-gray",
                "value": null
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 3
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "max(slurm_node_up{su=~\"$su\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Slurm node signal",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Unavailable until the Slurm node-state exporter is enabled; this is not used to colour node reachability.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "dark-gray",
            "mode": "fixed"
          },
          "decimals": 0,
          "noValue": "NOT EXPORTED",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-gray",
                "value": null
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 3
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "max(slurm_node_state{state=~\"down|drain|drained|draining|fail|failing|maint|unknown\",su=~\"$su\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Slurm unavailable / drained",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "The bounded BMC ping sweep has not been enabled in VictoriaMetrics. This is intentionally not inferred from node-exporter reachability.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "dark-gray",
            "mode": "fixed"
          },
          "decimals": 0,
          "noValue": "NOT EXPORTED",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-gray",
                "value": null
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 3
      },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "max(nvis_bmc_ping_up{su=~\"$su\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "BMC ping signal",
      "type": "stat"
    },
    {
