          "expr": "count((count by(node) (DCGM_FI_DEV_GPU_TEMP{cluster=~\"$cluster\", datahall=~\"$datahall\", su=~\"$su\", rack=~\"$rack\", node=~\"$node\", gpu=~\"$gpu\"})) unless (count by(node) (su1_nvlink_up{cluster=~\"$cluster\", datahall=~\"$datahall\", su=~\"$su\", rack=~\"$rack\", node=~\"$node\", gpu=~\"$gpu\"}))) or vector(0)",
