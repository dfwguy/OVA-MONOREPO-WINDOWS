          "expr": "count(DCGM_FI_DEV_CLOCK_THROTTLE_REASONS{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\"} > 1) or on() (count(DCGM_FI_DEV_GPU_TEMP{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\"}) * 0)",
          "instant": true,
          "refId": "A"
