          "expr": "count(DCGM_FI_DEV_ECC_SBE_AGG_TOTAL{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\"} > 0) or on() (count(DCGM_FI_DEV_GPU_TEMP{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\"}) * 0)",
