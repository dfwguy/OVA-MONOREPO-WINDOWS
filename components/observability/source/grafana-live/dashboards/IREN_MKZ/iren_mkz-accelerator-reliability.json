                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "basic",
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "SBE aggregate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "basic",
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Throttle mask"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "basic",
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "id": 10,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true,
        "sortBy": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_join(max by(node,rack,su,gpu)(DCGM_FI_DEV_CORRECTABLE_REMAPPED_ROWS{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\"} and on(node,gpu) ((DCGM_FI_DEV_CORRECTABLE_REMAPPED_ROWS{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\"} > 0) or (DCGM_FI_DEV_ECC_SBE_AGG_TOTAL{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\"} > 0) or (DCGM_FI_DEV_CLOCK_THROTTLE_REASONS{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\"} > 1))), \"entity\", \"/\", \"node\", \"gpu\")",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by(entity)(label_join(max by(node,gpu)(DCGM_FI_DEV_ECC_SBE_AGG_TOTAL{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\"} and on(node,gpu) ((DCGM_FI_DEV_CORRECTABLE_REMAPPED_ROWS{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\"} > 0) or (DCGM_FI_DEV_ECC_SBE_AGG_TOTAL{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\"} > 0) or (DCGM_FI_DEV_CLOCK_THROTTLE_REASONS{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\"} > 1))), \"entity\", \"/\", \"node\", \"gpu\"))",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by(entity)(label_join(max by(node,gpu)(DCGM_FI_DEV_ECC_SBE_VOL_TOTAL{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\"} and on(node,gpu) ((DCGM_FI_DEV_CORRECTABLE_REMAPPED_ROWS{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\"} > 0) or (DCGM_FI_DEV_ECC_SBE_AGG_TOTAL{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\"} > 0) or (DCGM_FI_DEV_CLOCK_THROTTLE_REASONS{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\"} > 1))), \"entity\", \"/\", \"node\", \"gpu\"))",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by(entity)(label_join(max by(node,gpu)(DCGM_FI_DEV_CLOCK_THROTTLE_REASONS{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\"} and on(node,gpu) ((DCGM_FI_DEV_CORRECTABLE_REMAPPED_ROWS{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\"} > 0) or (DCGM_FI_DEV_ECC_SBE_AGG_TOTAL{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\"} > 0) or (DCGM_FI_DEV_CLOCK_THROTTLE_REASONS{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\"} > 1))), \"entity\", \"/\", \"node\", \"gpu\"))",
          "format": "table",
          "instant": true,
          "refId": "D"
        }
      ],
      "title": "ECC, remap and throttle worklist",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "entity",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Hostname": true,
              "Time": true,
              "UUID": true,
              "__name__": true,
              "cluster": true,
              "device": true,
              "entity": true,
              "instance": true,
              "job": true,
              "modelName": true,
              "pci_bus_id": true
            },
            "renameByName": {
              "Value #A": "Correctable rows",
              "Value #B": "SBE aggregate",
              "Value #C": "SBE volatile",
              "Value #D": "Throttle mask"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Selected-range counter increases joined on the stable node/GPU entity. These counters are not interpreted as current state without a change in the chosen window.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "gpu"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "targetBlank": false,
                    "title": "Open GPU root cause",
                    "url": "/d/iren_mkz-gpu-root-cause?var-node=${__data.fields.node}&var-gpu=${__data.fields.gpu}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "id": 11,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true,
        "sortBy": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_join(topk(100, sum by(node,rack,su,gpu)(increase(DCGM_FI_DEV_POWER_VIOLATION{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\"}[$__range]))) > 0, \"entity\", \"/\", \"node\", \"gpu\")",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by(entity)(label_join(topk(100, sum by(node,gpu)(increase(DCGM_FI_DEV_THERMAL_VIOLATION{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\"}[$__range]))) > 0, \"entity\", \"/\", \"node\", \"gpu\"))",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by(entity)(label_join(topk(100, sum by(node,gpu)(increase(DCGM_FI_DEV_RELIABILITY_VIOLATION{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\"}[$__range]))) > 0, \"entity\", \"/\", \"node\", \"gpu\"))",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
