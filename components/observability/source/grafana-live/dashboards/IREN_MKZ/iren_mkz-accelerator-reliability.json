          "expr": "count(DCGM_FI_DEV_CORRECTABLE_REMAPPED_ROWS{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\"} > 0) or on() (count(DCGM_FI_DEV_GPU_TEMP{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\"}) * 0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Correctable remap GPUs",
      "type": "stat"
    },
    {
      "datasource": {
