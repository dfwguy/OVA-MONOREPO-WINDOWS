        },
        "showHeader": true,
        "sortBy": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(node_filesystem_readonly{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\",fstype!~\"tmpfs|overlay|squashfs|nsfs|autofs\"} == 1) or (node_filesystem_device_error{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\",fstype!~\"tmpfs|overlay|squashfs|nsfs|autofs\"} == 1) or ((100*(1-node_filesystem_files_free{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\",fstype!~\"tmpfs|overlay|squashfs|nsfs|autofs\"}/node_filesystem_files{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\",fstype!~\"tmpfs|overlay|squashfs|nsfs|autofs\"})) > 90)",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Filesystem failure modes",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "cluster": true,
              "datahall": true,
              "dgx_flavor": true,
              "instance": true,
              "job": true,
              "rack_ordinal": true,
              "racktype": true,
              "su_letter": true,
              "tray_index": true
            },
            "renameByName": {
              "Value": "Evidence"
            }
          }
        }
      ],
      "type": "table"
