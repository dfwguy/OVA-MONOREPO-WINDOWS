    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Persistent filesystems currently reported read-only.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 5
      },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(node_filesystem_readonly{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\",fstype!~\"tmpfs|overlay|squashfs|nsfs|autofs\"} == 1) or on() (count(node_filesystem_readonly{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\",fstype!~\"tmpfs|overlay|squashfs|nsfs|autofs\"}) * 0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Read-only filesystems",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Filesystem collectors reporting a device error; this is distinct from capacity.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
