          "expr": "count((100*(1-node_filesystem_files_free{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\",fstype!~\"tmpfs|overlay|squashfs|nsfs|autofs\"}/node_filesystem_files{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\",fstype!~\"tmpfs|overlay|squashfs|nsfs|autofs\"})) > 90) or on() (count(node_filesystem_files{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\",fstype!~\"tmpfs|overlay|squashfs|nsfs|autofs\"}) * 0)",
          "instant": true,
          "refId": "A"
        }
