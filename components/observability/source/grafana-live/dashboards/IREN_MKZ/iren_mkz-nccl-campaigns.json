          "expr": "count(last_over_time(nvis_slurm_job_state_code{cluster=\"IREN_MKZ\",state=\"COMPLETED\",job_id=~\"$nccl_job\"}[$__range]) and on(job_id) last_over_time(nvis_slurm_job_info{cluster=\"IREN_MKZ\",workload=\"nccl\",job_id=~\"$nccl_job\"}[$__range]))",
          "instant": true,
          "refId": "A"
        }
