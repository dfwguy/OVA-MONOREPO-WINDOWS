          "expr": "sum(last_over_time(nvis_slurm_job_log_tail_nccl_lines{cluster=\"IREN_MKZ\",job_id=~\"$nccl_job\"}[$__range]) and on(job_id) last_over_time(nvis_slurm_job_info{cluster=\"IREN_MKZ\",workload=\"nccl\",job_id=~\"$nccl_job\"}[$__range]))",
          "instant": true,
          "refId": "A"
        }
