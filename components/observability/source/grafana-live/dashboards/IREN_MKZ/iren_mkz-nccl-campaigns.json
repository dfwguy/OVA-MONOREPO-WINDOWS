    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Range-retained NCCL jobs. Click Job ID for the full flight recorder and correctness evidence.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "basic",
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "blue",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 3
                    },
                    {
                      "color": "red",
                      "value": 6
                    }
                  ]
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "0": {
                        "color": "blue",
                        "text": "UNKNOWN"
                      },
                      "1": {
                        "color": "yellow",
                        "text": "PENDING"
                      },
                      "10": {
                        "color": "red",
                        "text": "OUT OF MEMORY"
                      },
                      "2": {
                        "color": "blue",
                        "text": "CONFIGURING"
                      },
                      "3": {
                        "color": "green",
                        "text": "RUNNING"
                      },
                      "4": {
                        "color": "blue",
                        "text": "COMPLETING"
                      },
                      "5": {
                        "color": "green",
                        "text": "COMPLETED"
                      },
                      "6": {
                        "color": "orange",
                        "text": "CANCELLED"
                      },
                      "7": {
                        "color": "red",
                        "text": "FAILED"
                      },
                      "8": {
                        "color": "red",
                        "text": "TIMEOUT"
                      },
                      "9": {
                        "color": "red",
                        "text": "NODE FAIL"
                      }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "basic",
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "job_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "targetBlank": false,
                    "title": "Open job flight recorder",
                    "url": "/d/iren_mkz-job-root-cause?var-jobid=${__data.fields.job_id}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
