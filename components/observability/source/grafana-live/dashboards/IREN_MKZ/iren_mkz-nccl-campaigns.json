        "h": 12,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "id": 10,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "job_id"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "last_over_time(nvis_slurm_job_info{cluster=\"IREN_MKZ\",workload=\"nccl\",job_id=~\"$nccl_job\"}[$__range])",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "last_over_time(nvis_slurm_job_state_code{cluster=\"IREN_MKZ\",job_id=~\"$nccl_job\"}[$__range])",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "last_over_time(nvis_slurm_job_requested_nodes{cluster=\"IREN_MKZ\",job_id=~\"$nccl_job\"}[$__range])",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "last_over_time(nvis_slurm_job_allocated_nodes{cluster=\"IREN_MKZ\",job_id=~\"$nccl_job\"}[$__range])",
          "format": "table",
          "instant": true,
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "last_over_time(nvis_slurm_job_requested_gpus{cluster=\"IREN_MKZ\",job_id=~\"$nccl_job\"}[$__range])",
          "format": "table",
          "instant": true,
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "last_over_time(nvis_slurm_job_nccl_completed_tests{cluster=\"IREN_MKZ\",job_id=~\"$nccl_job\"}[$__range])",
          "format": "table",
          "instant": true,
          "refId": "F"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "last_over_time(nvis_slurm_job_log_tail_error_lines{cluster=\"IREN_MKZ\",job_id=~\"$nccl_job\"}[$__range])",
          "format": "table",
          "instant": true,
          "refId": "G"
        }
      ],
      "title": "NCCL jobs \u2014 identity, state, geometry and telemetry coverage",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "job_id",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "component": true,
              "instance": true,
              "job": true,
              "node": true,
              "observability_host": true,
              "requested_nodelist": true,
              "role": true,
              "stdout_file": true
            },
            "renameByName": {
              "Value #A": "Job",
              "Value #B": "State",
              "Value #C": "Requested nodes",
              "Value #D": "Allocated nodes",
              "Value #E": "Requested GPUs",
              "Value #F": "Parsed tests",
              "Value #G": "Error lines"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "desc": true,
                "field": "job_id"
              }
            ]
          }
        }
      ],
      "type": "table"
    },
