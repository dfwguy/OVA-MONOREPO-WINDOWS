  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "icon": "home",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "title": "\u2302 IREN_MKZ Home",
      "tooltip": "Back to IREN_MKZ Home",
      "type": "link",
      "url": "/d/iren_mkz-home?${__url_time_range}"
    },
    {
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "iren_mkz"
      ],
      "title": "IREN_MKZ Dashboards",
      "type": "dashboards"
    }
  ],
  "panels": [
    {
      "description": "Purpose, evidence contract, and routes to adjacent IREN_MKZ investigation boards.",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "content": "# IREN_MKZ \u2014 GPU Root Cause\n\n**Selected entity: `$node / GPU $gpu`.** DCGM evidence is GPU-exact; NVLink lane and service evidence is explicitly tray-scoped where PCI-to-index mapping is unavailable.\n\n[Home](/d/iren_mkz-home?${__url_time_range}) \u00b7 [Command Center](/d/iren_mkz-command-center?${__url_time_range}) \u00b7 [Live Topology](/d/iren_mkz-topology?${__url_time_range}) \u00b7 [Infrastructure](/d/iren_mkz-infrastructure?${__url_time_range}) \u00b7 [GPU & NVLink](/d/iren_mkz-accelerators?${__url_time_range}) \u00b7 [Fabric, CVT & Cabling](/d/iren_mkz-fabric?${__url_time_range}) \u00b7 [Workloads, Slurm & Validation](/d/iren_mkz-workloads?${__url_time_range})",
        "mode": "markdown"
      },
      "title": "",
      "transparent": true,
      "type": "text"
    },
    {
      "collapsed": false,
      "description": "GPU decision ribbon",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "id": 2,
      "panels": [],
      "title": "GPU decision ribbon",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Current selected-GPU core temperature.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "unit": "celsius"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 5
      },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(DCGM_FI_DEV_GPU_TEMP{cluster=\"IREN_MKZ\",node=~\"$node\",gpu=~\"$gpu\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Core temperature",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
