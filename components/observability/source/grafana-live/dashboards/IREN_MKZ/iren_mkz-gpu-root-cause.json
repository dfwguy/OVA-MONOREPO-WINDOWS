      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 5
      },
      "id": 6,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(DCGM_FI_DEV_POWER_USAGE{cluster=\"IREN_MKZ\",node=~\"$node\",gpu=~\"$gpu\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Board power",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Current DCGM XID code. A zero is anchored to the selected GPU temperature roster; labels retain the error code and message.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 5
      },
      "id": 7,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(DCGM_FI_DEV_XID_ERRORS{cluster=\"IREN_MKZ\",node=~\"$node\",gpu=~\"$gpu\"}) or on() (count(DCGM_FI_DEV_GPU_TEMP{cluster=\"IREN_MKZ\",node=~\"$node\",gpu=~\"$gpu\"}) * 0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "XID code",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Uncorrectable volatile ECC plus row-remap failure on the selected GPU.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 5
      },
      "id": 8,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(DCGM_FI_DEV_ECC_DBE_VOL_TOTAL{cluster=\"IREN_MKZ\",node=~\"$node\",gpu=~\"$gpu\"}) + max(DCGM_FI_DEV_ROW_REMAP_FAILURE{cluster=\"IREN_MKZ\",node=~\"$node\",gpu=~\"$gpu\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "ECC DBE / remap",
      "type": "stat"
    },
    {
      "collapsed": false,
      "description": "Exact identity, error state and workload",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 9,
      "panels": [],
      "title": "Exact identity, error state and workload",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Stable GPU identity, UUID, PCI address, device, model, rack and SU.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Core temp"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "basic",
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 70
                    },
                    {
                      "color": "orange",
                      "value": 80
                    },
                    {
                      "color": "red",
                      "value": 85
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "node"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "targetBlank": false,
                    "title": "Open tray root cause",
                    "url": "/d/iren_mkz-tray-root-cause?var-node=${__data.fields.node}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "id": 10,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true,
        "sortBy": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by(node,gpu,UUID,pci_bus_id,device,modelName,rack,su)(DCGM_FI_DEV_GPU_TEMP{cluster=\"IREN_MKZ\",node=~\"$node\",gpu=~\"$gpu\"})",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "GPU identity and current state",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Hostname": true,
              "Time": true,
              "__name__": true,
              "cluster": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "Value": "Core temp"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "XID, uncorrectable/correctable ECC, PCIe replay, and throttle bitmask for the selected GPU.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "XID"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "basic",
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ECC DBE"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "basic",
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "PCIe replay"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "basic",
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "id": 11,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true,
        "sortBy": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by(node,gpu,err_code,err_msg)(DCGM_FI_DEV_XID_ERRORS{cluster=\"IREN_MKZ\",node=~\"$node\",gpu=~\"$gpu\"})",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by(gpu)(DCGM_FI_DEV_ECC_DBE_VOL_TOTAL{cluster=\"IREN_MKZ\",node=~\"$node\",gpu=~\"$gpu\"})",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by(gpu)(DCGM_FI_DEV_ECC_SBE_VOL_TOTAL{cluster=\"IREN_MKZ\",node=~\"$node\",gpu=~\"$gpu\"})",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by(gpu)(DCGM_FI_DEV_PCIE_REPLAY_COUNTER{cluster=\"IREN_MKZ\",node=~\"$node\",gpu=~\"$gpu\"})",
          "format": "table",
          "instant": true,
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by(gpu)(DCGM_FI_DEV_CLOCK_THROTTLE_REASONS{cluster=\"IREN_MKZ\",node=~\"$node\",gpu=~\"$gpu\"})",
          "format": "table",
          "instant": true,
          "refId": "E"
        }
      ],
      "title": "Current GPU fault evidence",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "gpu",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "node": true
            },
            "renameByName": {
              "Value #A": "XID",
              "Value #B": "ECC DBE",
              "Value #C": "ECC SBE",
              "Value #D": "PCIe replay",
              "Value #E": "Throttle mask"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Current job-to-tray placement. This does not claim per-GPU scheduler allocation.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "jobid"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "targetBlank": false,
                    "title": "Open job root cause",
                    "url": "/d/iren_mkz-job-root-cause?var-jobid=${__data.fields.jobid}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 18
      },
      "id": 12,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true,
        "sortBy": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by(jobid,username,node,rack,su)(cgroup_info{cluster=\"IREN_MKZ\",node=~\"$node\",jobid!=\"\"})",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Job currently resident on the hosting tray",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "cgroup": true,
              "cluster": true,
              "instance": true,
              "job": true,
              "uid": true
            },
            "renameByName": {
              "Value": "Present"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Tray-scoped Fabric Manager/IMEX state plus GPU PCI fabric-registration state. Exact index mapping is not inferred.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Service active"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "0": {
                        "color": "red",
                        "text": "DOWN"
                      },
                      "1": {
                        "color": "green",
                        "text": "UP"
                      }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "basic",
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Fabric completed"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "0": {
                        "color": "red",
                        "text": "DOWN"
                      },
                      "1": {
                        "color": "green",
                        "text": "UP"
                      }
                    },
                    "type": "value"
                  }
                ]
