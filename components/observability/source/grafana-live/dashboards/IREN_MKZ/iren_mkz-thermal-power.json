      "id": 10,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Negative margin"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(100, -1*((node_hwmon_temp_crit_celsius{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\"} > 0) - ignoring(__name__) node_hwmon_temp_celsius{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\"}))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Sensors closest to critical",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "cluster": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "Value": "Negative margin"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "desc": true,
                "field": "Negative margin"
              }
            ]
          }
        }
      ],
      "type": "table"
    },
