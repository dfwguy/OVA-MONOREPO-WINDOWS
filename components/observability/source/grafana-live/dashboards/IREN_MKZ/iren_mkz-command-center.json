          "expr": "count(switch_health{cluster=\"IREN_MKZ\"} != 1) or on() (count(switch_health{cluster=\"IREN_MKZ\"}) * 0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Switches unhealthy",
      "type": "stat"
