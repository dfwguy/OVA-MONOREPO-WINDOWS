          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg(DCGM_FI_DEV_GPU_UTIL{cluster=\"IREN_MKZ\"})",
          "instant": true,
          "refId": "A"
        }
