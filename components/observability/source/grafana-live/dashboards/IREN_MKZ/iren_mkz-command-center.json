    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Unresponsive Alloy, node-exporter, cgroup-exporter, or DCGM targets. Zero is derived only when that same target roster is present.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "links": [
            {
              "targetBlank": false,
              "title": "Open tray worklist",
              "url": "/d/iren_mkz-infrastructure?${__url_time_range}"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 6,
        "y": 5
      },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(up{cluster=\"IREN_MKZ\",job=~\"alloy|node-exporter|cgroup-exporter|dcgm-exporter\"} == 0) or on() (count(up{cluster=\"IREN_MKZ\",job=~\"alloy|node-exporter|cgroup-exporter|dcgm-exporter\"}) * 0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Tray agents DOWN",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Host InfiniBand ports whose live state is not ACTIVE (state 4). Open Fabric for the exact HCA and node.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "links": [
            {
              "targetBlank": false,
              "title": "Open exact HCA worklist",
              "url": "/d/iren_mkz-fabric?${__url_time_range}"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 9,
        "y": 5
      },
      "id": 6,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(ib_hca_port_state{cluster=\"IREN_MKZ\"} != 4) or on() (count(ib_hca_port_state{cluster=\"IREN_MKZ\"}) * 0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "HCA ports not ACTIVE",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "SIB/P2P switch inventory entries with current health other than 1. This is inventory health, not full UFM/Cumulus telemetry.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "links": [
            {
              "targetBlank": false,
              "title": "Open exact switch worklist",
              "url": "/d/iren_mkz-fabric?${__url_time_range}"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
