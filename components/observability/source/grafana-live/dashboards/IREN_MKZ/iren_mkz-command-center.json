    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "GPUs with critical core/HBM temperature, XID, volatile double-bit ECC, or row-remap failure. The Accelerator dashboard lists each GPU.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "links": [
            {
              "targetBlank": false,
              "title": "Open exact GPU worklist",
              "url": "/d/iren_mkz-accelerators?${__url_time_range}"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 15,
        "y": 5
      },
      "id": 8,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count((max by(node,rack,su,gpu)(label_replace((DCGM_FI_DEV_GPU_TEMP{cluster=\"IREN_MKZ\"} >= bool 85) * 2, \"fault\", \"core_temp\", \"\", \"\") or label_replace((DCGM_FI_DEV_MEMORY_TEMP{cluster=\"IREN_MKZ\"} >= bool 90) * 2, \"fault\", \"hbm_temp\", \"\", \"\") or label_replace((DCGM_FI_DEV_ECC_DBE_VOL_TOTAL{cluster=\"IREN_MKZ\"} > bool 0) * 3, \"fault\", \"ecc_dbe\", \"\", \"\") or label_replace((DCGM_FI_DEV_ECC_DBE_AGG_TOTAL{cluster=\"IREN_MKZ\"} > bool 0) * 3, \"fault\", \"ecc_dbe_aggregate\", \"\", \"\") or label_replace((DCGM_FI_DEV_UNCORRECTABLE_REMAPPED_ROWS{cluster=\"IREN_MKZ\"} > bool 0) * 3, \"fault\", \"uncorrectable_remap\", \"\", \"\") or label_replace((DCGM_FI_DEV_ROW_REMAP_FAILURE{cluster=\"IREN_MKZ\"} > bool 0) * 3, \"fault\", \"row_remap\", \"\", \"\") or label_replace((DCGM_FI_DEV_XID_ERRORS{cluster=\"IREN_MKZ\"} > bool 0) * 3, \"fault\", \"xid\", \"\", \"\"))) > 0) or on() (count(DCGM_FI_DEV_GPU_TEMP{cluster=\"IREN_MKZ\"}) * 0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "GPU critical evidence",
      "type": "stat"
    },
