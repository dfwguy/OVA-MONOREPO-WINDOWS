            {
              "targetBlank": false,
              "title": "Open GPU efficiency",
              "url": "/d/iren_mkz-ai-performance?${__url_time_range}"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
