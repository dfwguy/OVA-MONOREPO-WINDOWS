          "expr": "label_join(topk(100, sum by(node,rack,su,device)(increase(node_network_carrier_down_changes_total{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\",device=~\"bond0|enP.*\"}[$__range]))) > 0, \"entity\", \"/\", \"node\", \"device\")",
