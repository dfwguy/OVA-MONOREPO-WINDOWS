      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Errors + drops"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(100, sum by(node,rack,su,device)(increase(node_network_receive_errs_total{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\",device=~\"bond0|enP.*\"}[$__range]) + increase(node_network_transmit_errs_total{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\",device=~\"bond0|enP.*\"}[$__range]) + increase(node_network_receive_drop_total{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\",device=~\"bond0|enP.*\"}[$__range]) + increase(node_network_transmit_drop_total{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\",device=~\"bond0|enP.*\"}[$__range]) + increase(node_network_receive_frame_total{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\",device=~\"bond0|enP.*\"}[$__range]) + increase(node_network_transmit_carrier_total{cluster=\"IREN_MKZ\",su=~\"$su\",rack=~\"$rack\",node=~\"$node\",device=~\"bond0|enP.*\"}[$__range]))) > 0",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Error and drop offenders",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "Value": "Errors + drops"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "desc": true,
                "field": "Errors + drops"
              }
            ]
          }
        }
      ],
      "type": "table"
    },
