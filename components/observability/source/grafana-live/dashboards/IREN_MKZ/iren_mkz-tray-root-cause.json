          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(count by(jobid)(cgroup_info{cluster=\"IREN_MKZ\",node=~\"$node\",jobid!=\"\"})) or on() (count(up{cluster=\"IREN_MKZ\",node=~\"$node\",job=\"cgroup-exporter\"}) * 0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Current jobs",
      "type": "stat"
