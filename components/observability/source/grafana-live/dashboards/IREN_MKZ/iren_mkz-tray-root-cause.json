      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(ib_hca_port_state{cluster=\"IREN_MKZ\",node=~\"$node\"} != 4) or on() (count(ib_hca_port_state{cluster=\"IREN_MKZ\",node=~\"$node\"}) * 0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "HCA not ACTIVE",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "GPUs with current XID, uncorrectable ECC, remap failure, or critical thermal evidence. Zero requires a live GPU roster.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 5
      },
      "id": 7,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count((DCGM_FI_DEV_XID_ERRORS{cluster=\"IREN_MKZ\",node=~\"$node\"}>0) or (DCGM_FI_DEV_ECC_DBE_VOL_TOTAL{cluster=\"IREN_MKZ\",node=~\"$node\"}>0) or (DCGM_FI_DEV_ROW_REMAP_FAILURE{cluster=\"IREN_MKZ\",node=~\"$node\"}>0) or (DCGM_FI_DEV_GPU_TEMP{cluster=\"IREN_MKZ\",node=~\"$node\"}>=85) or (DCGM_FI_DEV_MEMORY_TEMP{cluster=\"IREN_MKZ\",node=~\"$node\"}>=90)) or on() (count(DCGM_FI_DEV_GPU_TEMP{cluster=\"IREN_MKZ\",node=~\"$node\"}) * 0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Critical GPUs",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Distinct live Slurm job cgroups on this tray. Zero is shown only when its cgroup exporter target exists.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
