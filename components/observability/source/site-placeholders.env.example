CLUSTER_NAME=IREN_MKZ
TZ=America/Chicago
GRAFANA_ADMIN_PASSWORD_FROM_SECRET_STORE=<required-secret-provider-reference>
VM_STORAGE_PATH=/var/lib/nvis-observability/victoriametrics
VM_LISTEN_ADDRESS=host.docker.internal
PROMETHEUS_STORAGE_PATH=/var/lib/nvis-observability/prometheus
LOKI_STORAGE_PATH=/var/lib/nvis-observability/loki
ALLOY_STORAGE_PATH=/var/lib/nvis-observability/alloy
GRAFANA_STORAGE_PATH=/var/lib/nvis-observability/grafana
SLURM_BIN=/cm/local/apps/slurm/current/bin
SLURM_CONF=/cluster/slurm/etc/slurm/slurm.conf
VALIDATION_LOG_ROOT=/cluster/OVA/logs/iren_mkz-16k-validation
UFM_HOST=<site-ufm-host-or-ip>
REDFISH_TARGETS_CSV=/etc/nvis-observability/redfish-targets.csv
