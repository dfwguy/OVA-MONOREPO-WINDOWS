// ─────────────────────────────────────────────────────────────────────────────
// NVIS GB300 node Alloy agent — instance=example50-dh01-c24-37 cluster=IREN_MKZ su=SU14
// Generated by install-node.sh. Do not edit by hand (re-run installer to update).
// ─────────────────────────────────────────────────────────────────────────────

logging {
  level  = "info"
  format = "logfmt"
}

// Prometheus remote_write → this node's SHARD (WAL-buffered: survives receiver downtime)
prometheus.remote_write "obsvm" {
  endpoint {
    url = "http://192.0.2.10:8428/api/v1/write"
  }
  external_labels = {
    cluster      = "IREN_MKZ",
    dgx_flavor   = "GB300",
    su           = "SU14",
    su_letter    = "c",
    datahall     = "WH1C",
    rack         = "WH1C24",
    rack_ordinal = "24",
    tray_index   = "37",
    racktype     = "GB300_72x1",
    node         = "example50-dh01-c24-37",
  }
}

// DCGM exporter (localhost:9400) — honor_timestamps=false per NVIS standard.
// honor_labels via relabel: keep the per-series gpu label dcgm-exporter emits.
prometheus.scrape "dcgm" {
  targets          = [{ __address__ = "localhost:9400" }]
  scrape_interval  = "15s"
  honor_timestamps = false
  forward_to       = [prometheus.relabel.dcgm.receiver]
}
prometheus.relabel "dcgm" {
  forward_to = [prometheus.remote_write.obsvm.receiver]
  rule {
    target_label = "job"
    replacement = "dcgm-exporter"
  }
  rule {
    target_label = "instance"
    replacement = "example50-dh01-c24-37"
  }
}

// node_exporter (localhost:9100)
prometheus.scrape "node_exporter" {
  targets         = [{ __address__ = "localhost:9100" }]
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.node_exporter.receiver]
}
prometheus.relabel "node_exporter" {
  forward_to = [prometheus.remote_write.obsvm.receiver]
  rule {
    target_label = "job"
    replacement = "node-exporter"
  }
  rule {
    target_label = "instance"
    replacement = "example50-dh01-c24-37"
  }
}

// cgroup_exporter (localhost:9306) — per-Slurm-job cpu/mem/io keyed by jobid
prometheus.scrape "cgroup_exporter" {
  targets         = [{ __address__ = "localhost:9306" }]
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.cgroup_exporter.receiver]
}
prometheus.relabel "cgroup_exporter" {
  forward_to = [prometheus.remote_write.obsvm.receiver]
  rule {
    target_label = "job"
    replacement = "cgroup-exporter"
  }
  rule {
    target_label = "instance"
    replacement = "example50-dh01-c24-37"
  }
}

// Alloy self-metrics (localhost:12345) — per-node agent health visible centrally
prometheus.scrape "alloy" {
  targets         = [{ __address__ = "localhost:12345" }]
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.alloy.receiver]
}
prometheus.relabel "alloy" {
  forward_to = [prometheus.remote_write.obsvm.receiver]
  rule {
    target_label = "job"
    replacement = "alloy"
  }
  rule {
    target_label = "instance"
    replacement = "example50-dh01-c24-37"
  }
}

// Loki write → ObsVM :3100 (single, not sharded)
loki.write "obsvm" {
  endpoint {
    url = "http://192.0.2.10:3100/loki/api/v1/push"
  }
  external_labels = {
    cluster      = "IREN_MKZ",
    dgx_flavor   = "GB300",
    su           = "SU14",
    su_letter    = "c",
    datahall     = "WH1C",
    rack         = "WH1C24",
    rack_ordinal = "24",
    tray_index   = "37",
    racktype     = "GB300_72x1",
    node         = "example50-dh01-c24-37",
  }
}

// ── Log tailing: dmesg / kernel / var-log / DCGM / NCCL / Slurm ──────────────
local.file_match "logfiles" {
  path_targets = [
    { __path__ = "/var/log/syslog",              job = "syslog",     service = "syslog",     instance = "example50-dh01-c24-37" },
    { __path__ = "/var/log/kern.log",            job = "kernel",     service = "kernel",     instance = "example50-dh01-c24-37" },
    { __path__ = "/var/log/dmesg",               job = "dmesg",     service = "dmesg",      instance = "example50-dh01-c24-37" },
    { __path__ = "/var/log/messages",            job = "syslog",     service = "syslog",     instance = "example50-dh01-c24-37" },
    { __path__ = "/var/log/nv-hostengine.log",   job = "dcgm",     service = "dcgm",       instance = "example50-dh01-c24-37" },
    { __path__ = "/var/log/slurm/*.log",         job = "slurm",     service = "slurm",      instance = "example50-dh01-c24-37" },
    { __path__ = "/var/log/slurm*",              job = "slurm",     service = "slurm",      instance = "example50-dh01-c24-37" },
    { __path__ = "/var/log/nccl/*.log",             job = "nccl-debug",     service = "nccl-debug", instance = "example50-dh01-c24-37" },
    { __path__ = "/var/spool/slurmd/job*/slurm_script",          job = "slurm-job",     service = "slurm-job",  instance = "example50-dh01-c24-37" },
  ]
}
loki.source.file "logfiles" {
  targets    = local.file_match.logfiles.targets
  forward_to = [loki.write.obsvm.receiver]
}

// systemd journal (includes kernel/dmesg via _TRANSPORT=kernel + all unit logs)
loki.source.journal "journal" {
  forward_to    = [loki.write.obsvm.receiver]
  relabel_rules = loki.relabel.journal.rules
  labels = {
    job      = "journal",
    // NVIS: the NVIS dashboards select on  (gpu-nvlink-health log panels use
    // service=~".*(kernel|syslog|journal|node).*"). Loki 3 auto-derives service_name, NOT
    // service, so without this the node's logs land in Loki but match no panel.
    service  = "journal",
    instance = "example50-dh01-c24-37",
  }
}
loki.relabel "journal" {
  forward_to = []
  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label = "unit"
  }
  rule {
    source_labels = ["__journal__transport"]
    target_label = "transport"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label = "level"
  }
}
